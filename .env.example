# CodeGuard AI Platform Configuration Template

# Database Configurations
POSTGRES_DB=codeguard_db
POSTGRES_USER=codeguard_admin
POSTGRES_PASSWORD=your_secure_db_password_here

# JSON Web Token Secret Keys
JWT_SECRET=generate_and_place_a_secure_base64_encoded_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# GitHub Integration
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_key

# AI Services
GEMINI_API_KEY=your_google_gemini_api_key_here
